<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="?attr/colorOutlineVariant"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivAppointmentTreatment"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/treatment_photo_description"
                android:scaleType="centerCrop"
                android:src="@android:drawable/ic_menu_agenda" />

            <TextView
                android:id="@+id/tvAppointmentService"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textStyle="bold"
                tools:text="Limpieza dental" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvAppointmentDateTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="15/11/2026 10:30" />

        <TextView
            android:id="@+id/tvAppointmentDentist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorPrimary"
            android:visibility="gone"
            tools:text="Con Dra. Ana Ramírez"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tvAppointmentSuggestionLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/agenda_suggestion"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvAppointmentSuggestion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:visibility="gone"
            tools:text="Sugerencia del dentista: Mantén la zona limpia." />

        <TextView
            android:id="@+id/tvAppointmentPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="Precio total: $30.00"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tvAppointmentDeposit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorSecondary"
            android:visibility="gone"
            tools:text="Abono pendiente en clínica: $7.50 de $30.00"
            tools:visibility="visible" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvAppointmentStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:textStyle="bold"
                tools:text="Pendiente" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelAppointment"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/appointments_cancel_action"
                android:textColor="?attr/colorError" />
        </LinearLayout>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
